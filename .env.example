# FinSight AI — Application Environment Variables Template
# Copy this file to .env and fill in your actual production values.
# NEVER commit real secret values to Git!

# Environment & Server Settings
ENVIRONMENT=production
DEBUG=false
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Production CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=https://your-firebase-app-id.web.app,https://your-firebase-app-id.firebaseapp.com

# LLM API Keys (Groq / Gemini)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_production_gemini_api_key
GROQ_API_KEY=your_production_groq_api_key
OPENAI_API_KEY=

# ChromaDB & Document Processing Limits
CHROMA_PERSIST_DIRECTORY=./chroma_data
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
DEFAULT_TOP_K=4
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_UPLOAD_SIZE_MB=25
MAX_PDF_PAGES=150
PDF_PROCESSING_TIMEOUT_SEC=60

# Firebase Configuration
FIREBASE_CREDENTIALS_PATH=./serviceAccountKey.json
FIREBASE_STORAGE_BUCKET=your-firebase-app-id.appspot.com
