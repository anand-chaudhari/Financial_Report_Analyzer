# Backend Environment Variables Template
ENVIRONMENT=production
DEBUG=false
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS Origins (Comma-separated list of live frontend domains)
CORS_ORIGINS=https://your-firebase-app-id.web.app,https://your-firebase-app-id.firebaseapp.com

# LLM Providers
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_production_gemini_api_key
GROQ_API_KEY=your_production_groq_api_key
OPENAI_API_KEY=

# ChromaDB & Vector Settings
CHROMA_PERSIST_DIRECTORY=./chroma_data
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
DEFAULT_TOP_K=4

# Document Limits
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_UPLOAD_SIZE_MB=25
MAX_PDF_PAGES=150
PDF_PROCESSING_TIMEOUT_SEC=60

# Firebase Credentials
FIREBASE_CREDENTIALS_PATH=./serviceAccountKey.json
# Production Firebase Service Account (Paste minified JSON string or Base64 string below)
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_CREDENTIALS_BASE64=
FIREBASE_STORAGE_BUCKET=your-firebase-app-id.appspot.com
