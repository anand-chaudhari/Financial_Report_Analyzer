# FinSight AI — Backend Environment Variables Template
# ─────────────────────────────────────────────────────
# STEP 1: Copy this file to backend/.env
#         cp backend/.env.example backend/.env
#         (Windows: copy backend\.env.example backend\.env)
#
# STEP 2: Fill in your real API keys below.
# NEVER commit the filled-in .env file to Git!
# ─────────────────────────────────────────────────────

# ── App / Server ─────────────────────────────────────
ENVIRONMENT=development
DEBUG=false
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ── CORS (allow Vite dev server) ─────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ── LLM Providers ─────────────────────────────────────
# Primary LLM: Gemini (free tier available at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional fast fallback: Groq (free tier at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Optional: NVIDIA NIM (https://build.nvidia.com)
NVIDIA_API_KEY=your_nvidia_api_key_here

# LLM routing: options are "gemini", "groq", "nvidia"
LLM_PROVIDER=gemini

# ── ChromaDB & Vector Store ───────────────────────────
CHROMA_PERSIST_DIRECTORY=./chroma_data
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
DEFAULT_TOP_K=4

# ── Document Processing (Localhost Optimized) ─────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_UPLOAD_SIZE_MB=250
MAX_PDF_PAGES=2000
PDF_PROCESSING_TIMEOUT_SEC=600

# ── Firebase Authentication ───────────────────────────
# Place your downloaded Firebase service account JSON at:
#   backend/serviceAccountKey.json
# Then set the path below:
FIREBASE_CREDENTIALS_PATH=./serviceAccountKey.json

# Advanced: Paste minified JSON string (for CI/CD, not needed for localhost)
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_CREDENTIALS_BASE64=
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
