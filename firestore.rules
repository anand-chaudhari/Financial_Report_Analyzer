rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Documents collection rules
    match /documents/{documentId} {
      allow read, write, delete: if isOwner(resource.data.userId) || isOwner(request.resource.data.userId);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // Reports collection rules
    match /reports/{reportId} {
      allow read, write, delete: if isOwner(resource.data.user_id) || isOwner(request.resource.data.user_id);
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
    }

    // Conversations collection rules
    match /conversations/{conversationId} {
      allow read, write, delete: if isOwner(resource.data.userId) || isOwner(request.resource.data.userId);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;

      // Nested messages subcollection
      match /messages/{messageId} {
        allow read, write, delete: if isOwner(resource.data.userId) || isOwner(request.resource.data.userId);
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      }
    }

    // AI Analysis Persistent Cache rules
    match /ai_analysis_cache/{cacheKey} {
      allow read, write, delete: if isOwner(resource.data.user_id) || isOwner(request.resource.data.user_id);
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
    }
  }
}
