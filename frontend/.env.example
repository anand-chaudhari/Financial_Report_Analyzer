# FinSight AI — Frontend Environment Variables Template
# ─────────────────────────────────────────────────────
# STEP 1: Copy this file to frontend/.env
#         cp frontend/.env.example frontend/.env
#         (Windows: copy frontend\.env.example frontend\.env)
#
# STEP 2: Fill in your Firebase project config below.
# Get these values from your Firebase project console:
#   Firebase Console → Project Settings → General → "Your apps" → Web App → Config
#
# NEVER commit the filled-in .env file to Git!
# ─────────────────────────────────────────────────────

# ── Backend API URL ───────────────────────────────────
# For localhost development — keep this as-is:
VITE_API_BASE_URL=http://localhost:8000

# ── Firebase Web App Configuration ───────────────────
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
